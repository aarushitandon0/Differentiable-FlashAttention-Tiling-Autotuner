# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Compiled cost-model artifacts (built by tesseract_config.yaml's
# custom_build_steps, or locally via g++ for development; see
# tesseracts/attention-cost-model/tesseract_api.py's _LIB_CANDIDATES).
tesseracts/attention-cost-model/lib/
*.so
*.dll
*.dylib
*.o
*.obj

# Training runs: loss curves, eval-prediction traces, policy checkpoints,
# and comparison plots are all regenerated by policy/train.py and
# baselines/compare.py. Not committed since they are large and
# non-deterministic across seeds/hardware; regenerate with:
#   python -m policy.train
#   python -m baselines.compare --checkpoint runs/<run_id>/policy_final.eqx
runs/
!runs/.gitkeep

# JAX / equinox checkpoints anywhere else in the tree
*.eqx

# Tesseract build/output
.tesseract/
tesseract_output/

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
